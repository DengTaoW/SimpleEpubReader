<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EpubReader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EpubReader"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="EpubReader">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel Orientation="Vertical" Spacing="12">
            <Button Click="OpenFile_ButtonClick">
                <SymbolIcon Symbol="OpenFile" />
            </Button>

            <TextBlock TextWrapping="WrapWholeWords">
                <Run>META-INF/container.xml: </Run>
                <Run x:Name="ContainerXml"></Run>
            </TextBlock>

            <Image x:Name="CoverImage" Height="300" HorizontalAlignment="Center"/>

        </StackPanel>
    </ScrollViewer>
</Window>
